{
  "name": "intlify.dev",
  "description": "The borderless internationalization",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "type": "module",
  "packageManager": "pnpm@8.8.0",
  "engines": {
    "node": ">= 20"
  },
  "dependencies": {
    "vue": "^3.5.38",
    "vue-i18n": "^9.5.0"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@intlify/unplugin-vue-i18n": "^1.4.0",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20.6.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "lint-staged": "^14.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.31",
    "prettier": "^3.0.3",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.61.1",
    "vitepress": "^1.6.4"
  },
  "scripts": {
    "build": "vitepress build",
    "dev": "vitepress dev",
    "preview": "vitepress preview",
    "test": "pnpm run lint",
    "fix": "npm-run-all --parallel lint:fix format:fix",
    "format": "prettier --config .prettierrc --ignore-path .prettierignore '**/*.{ts,js,html,json}'",
    "format:fix": "pnpm format --write",
    "lint": "npm-run-all --parallel lint:eslint",
    "lint:eslint": "eslint .vitepress",
    "lint:fix": "pnpm lint:eslint --fix"
  },
  "lint-staged": {
    "*.{json,md,yml}": [
      "prettier --write"
    ],
    "*.{js,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write",
      "eslint --fix"
    ]
  }
}
